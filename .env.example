# Resend transactional email (contact form, health check)
RESEND_API_KEY=

# Optional: shared bearer token for /api/health/contact
HEALTHCHECK_TOKEN=

# Contact-form test sentinel (LAC-4028).
# Submitting the form with CONTACT_TEST_EMAIL as the submitter address
# reroutes delivery to CONTACT_TEST_RECIPIENT with a "[TEST] " subject prefix.
# Lets the fleet health check prove delivery without spamming the real inbox.
CONTACT_TEST_EMAIL=test@test.com
CONTACT_TEST_RECIPIENT=admin@buildandserve.com
